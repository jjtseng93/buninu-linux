#!/bin/bun
// unzip — list, test and extract zip archives (stored and deflated members,
// zip64 included) over node:zlib.
//
// Supported: -p (members to standard output), -l (list), -t (test),
// -d DIR, -o (overwrite), -n (never overwrite), -j (junk paths), -q/-qq;
// MEMBER operands may be wildcards. Unix modes (without setuid, setgid and
// sticky, as Info-ZIP leaves them off without -K), symlinks and modification
// times are restored. Member data streams through inflate, so a member is
// never held in memory whole, and nothing is ever written through a symlink:
// a member whose path runs through a link the archive (or anyone) made is
// skipped. Runs under node as well as bun.

import { constants, chmodSync, closeSync, fstatSync, lstatSync, lutimesSync, mkdirSync, openSync, readSync, rmSync, symlinkSync, utimesSync, writeSync } from "node:fs";
import { basename, join, normalize, resolve } from "node:path";
import { Readable } from "node:stream";
import { pipeline } from "node:stream/promises";
import { createInflateRaw } from "node:zlib";
import * as zlib from "node:zlib";
import { crc32 as crc32js } from "../lib/crc32.js";

// node:zlib's crc32 is native where the runtime has it, /lib/crc32.js elsewhere.
const crc32 = typeof zlib.crc32 === "function" ? (bytes, previous = 0) => zlib.crc32(bytes, previous) >>> 0 : crc32js;

const fail = (message, status = 1) => {
  console.error(`unzip: ${message}`);
  process.exit(status);
};

const usage = () => {
  console.error(`Usage:
  unzip [-o|-n] [-j] [-q] ZIP [MEMBER...] [-d DIR]
  unzip -p ZIP [MEMBER...]
  unzip -l ZIP [MEMBER...]
  unzip -t ZIP`);
  process.exit(10);
};

let mode = "extract";
let overwrite = null; // null: refuse, true: -o, false: -n
let junkPaths = false;
let quiet = 0;
let directory = ".";
const operands = [];
const argv = process.argv.slice(2);
for (let index = 0; index < argv.length; index++) {
  const argument = argv[index];
  if (argument === "-h" || argument === "--help") usage();
  if (argument === "-d") {
    if (index + 1 >= argv.length) fail("-d requires a directory", 10);
    directory = argv[++index];
    continue;
  }
  if (argument.startsWith("-d") && argument.length > 2) { directory = argument.slice(2); continue; }
  if (argument.startsWith("-") && argument.length > 1) {
    for (const letter of argument.slice(1)) {
      if (letter === "p") mode = "pipe";
      else if (letter === "l") mode = "list";
      else if (letter === "t") mode = "test";
      else if (letter === "o") overwrite = true;
      else if (letter === "n") overwrite = false;
      else if (letter === "j") junkPaths = true;
      else if (letter === "q") quiet++;
      else fail(`unknown option -${letter}`, 10);
    }
    continue;
  }
  operands.push(argument);
}
if (operands.length === 0) usage();
const [archive, ...patterns] = operands;

const fd = (() => {
  try { return openSync(archive, constants.O_RDONLY | (constants.O_NONBLOCK ?? 0)); } catch (error) { return fail(`cannot open ${archive}: ${error.message}`, 9); }
})();
const info = fstatSync(fd);
if (!info.isFile()) fail(`${archive}: not a regular file`, 3);
const size = info.size;
const validSize = (value) => Number.isSafeInteger(value) && value >= 0;
const uint64 = (buffer, offset) => {
  const value = buffer.readBigUInt64LE(offset);
  if (value > BigInt(Number.MAX_SAFE_INTEGER)) fail(`${archive}: ZIP64 value exceeds safe integer range`, 3);
  return Number(value);
};
const read = (position, length) => {
  if (!validSize(position) || !validSize(length) || position > size || length > size - position)
    fail(`${archive}: invalid or truncated archive range`, 3);
  let buffer;
  try { buffer = Buffer.alloc(length); }
  catch { fail(`${archive}: cannot allocate member buffer`, 3); }
  let done = 0;
  while (done < length) {
    const count = readSync(fd, buffer, done, length - done, position + done);
    if (count === 0) fail(`${archive}: unexpected end of file`, 3);
    done += count;
  }
  return buffer;
};

// End of central directory: in the last 64 KiB + 22 bytes, searched backwards.
const tailLength = Math.min(size, 65557);
const tail = read(size - tailLength, tailLength);
let eocd = -1;
for (let offset = tailLength - 22; offset >= 0; offset--) {
  if (tail.readUInt32LE(offset) === 0x06054b50 && offset + 22 + tail.readUInt16LE(offset + 20) === tail.length) { eocd = offset; break; }
}
if (eocd < 0) fail(`${archive}: not a zip archive (no end of central directory)`, 9);
if (tail.readUInt16LE(eocd + 4) !== 0 || tail.readUInt16LE(eocd + 6) !== 0
    || tail.readUInt16LE(eocd + 8) !== tail.readUInt16LE(eocd + 10))
  fail(`${archive}: split archives are not supported`, 3);
let entryCount = tail.readUInt16LE(eocd + 10);
let directorySize = tail.readUInt32LE(eocd + 12);
let directoryOffset = tail.readUInt32LE(eocd + 16);
let directoryLimit = size - tailLength + eocd;
// zip64: the locator sits just before the end of central directory record.
if (eocd >= 20 && tail.readUInt32LE(eocd - 20) === 0x07064b50) {
  if (tail.readUInt32LE(eocd - 16) !== 0 || tail.readUInt32LE(eocd - 4) !== 1)
    fail(`${archive}: split ZIP64 archives are not supported`, 3);
  const recordOffset = uint64(tail, eocd - 20 + 8);
  if (recordOffset > directoryLimit - 20 - 56) fail(`${archive}: invalid ZIP64 record range`, 3);
  const record = read(recordOffset, 56);
  if (record.readUInt32LE(0) !== 0x06064b50) fail(`${archive}: bad zip64 end of central directory`, 3);
  if (record.readUInt32LE(16) !== 0 || record.readUInt32LE(20) !== 0
      || uint64(record, 24) !== uint64(record, 32) || uint64(record, 4) < 44)
    fail(`${archive}: invalid or split ZIP64 directory`, 3);
  if (uint64(record, 4) > directoryLimit - 20 - recordOffset - 12)
    fail(`${archive}: truncated ZIP64 record`, 3);
  directoryLimit = recordOffset;
  entryCount = uint64(record, 32);
  directorySize = uint64(record, 40);
  directoryOffset = uint64(record, 48);
}

// Info-ZIP writes UTF-8 names without the 0x800 flag, so a name that decodes as UTF-8 is read as
// UTF-8 and only the rest as the old code page's stand-in, latin1.
const strictUtf8 = new TextDecoder("utf-8", { fatal: true });
const memberName = (raw, flags) => {
  if (flags & 0x800) return raw.toString("utf8");
  try { return strictUtf8.decode(raw); } catch { return raw.toString("latin1"); }
};

const entries = [];
if (!validSize(entryCount) || !validSize(directorySize) || !validSize(directoryOffset)
    || directoryOffset > directoryLimit || directorySize > directoryLimit - directoryOffset
    || entryCount > Math.floor(directorySize / 46)) fail(`${archive}: invalid central directory bounds`, 3);
let directoryPosition = 0;
for (let index = 0; index < entryCount; index++) {
  if (directorySize - directoryPosition < 46) fail(`${archive}: truncated central directory`, 3);
  const header = read(directoryOffset + directoryPosition, 46);
  const entryLength = 46 + header.readUInt16LE(28) + header.readUInt16LE(30) + header.readUInt16LE(32);
  if (entryLength > directorySize - directoryPosition) fail(`${archive}: truncated central entry`, 3);
  // Read one bounded entry instead of allocating the untrusted whole-directory size.
  const central = read(directoryOffset + directoryPosition, entryLength), offset = 0;
  if (central.readUInt16LE(34) !== 0) fail(`${archive}: split members are not supported`, 3);
  if (central.readUInt32LE(offset) !== 0x02014b50) fail(`${archive}: bad central directory entry ${index}`, 3);
  const nameLength = central.readUInt16LE(offset + 28);
  const extraLength = central.readUInt16LE(offset + 30);
  const flags = central.readUInt16LE(offset + 8);
  const entry = {
    madeBy: central.readUInt16LE(offset + 4) >> 8,
    flags,
    method: central.readUInt16LE(offset + 10),
    time: central.readUInt16LE(offset + 12),
    date: central.readUInt16LE(offset + 14),
    crc: central.readUInt32LE(offset + 16),
    compressedSize: central.readUInt32LE(offset + 20),
    size: central.readUInt32LE(offset + 24),
    external: central.readUInt32LE(offset + 38),
    localOffset: central.readUInt32LE(offset + 42),
    name: memberName(central.subarray(offset + 46, offset + 46 + nameLength), flags),
  };
  // zip64 extra field: the 0xFFFFFFFF fields follow, in this order.
  const extra = central.subarray(offset + 46 + nameLength, offset + 46 + nameLength + extraLength);
  const required64 = ["size", "compressedSize", "localOffset"].filter(key => entry[key] === 0xffffffff);
  let found64 = false;
  for (let position = 0; position < extra.length;) {
    if (extra.length - position < 4) fail(`${archive}: truncated extra field`, 3);
    const id = extra.readUInt16LE(position);
    const length = extra.readUInt16LE(position + 2);
    if (length > extra.length - position - 4) fail(`${archive}: truncated extra field`, 3);
    // "UT": the modification time in whole Unix seconds, which the DOS stamp rounds to two.
    if (id === 0x5455 && length >= 5 && extra[position + 4] & 1) entry.mtime = extra.readInt32LE(position + 5);
    if (id === 0x0001 && !found64) {
      found64 = true;
      let field = position + 4;
      for (const key of required64) {
        if (field + 8 > position + 4 + length) fail(`${archive}: truncated ZIP64 extra field`, 3);
        entry[key] = uint64(extra, field); field += 8;
      }
    }
    position += 4 + length;
  }
  if (required64.length && !found64) fail(`${archive}: missing ZIP64 extra field`, 3);
  if (entry.localOffset > directoryOffset || directoryOffset - entry.localOffset < 30
      || entry.compressedSize > directoryOffset - entry.localOffset - 30)
    fail(`${archive}: invalid member range`, 3);
  entries.push(entry);
  directoryPosition += entryLength;
}

// Bun.Glob when running under Bun; elsewhere the wildcards become a RegExp:
// * and ? match across "/" as in Info-ZIP, [...] is a set.
const globToRegExp = (pattern) => new RegExp(`^${pattern.replace(/\[[^\]]*\]|[*?]|[.+^${}()|\\]/g, (token) =>
  token === "*" ? ".*" : token === "?" ? "." : token.startsWith("[") ? token.replace(/^\[!/, "[^") : `\\${token}`)}$`, "s");
const toMatcher = (pattern) => {
  if (typeof Bun !== "undefined") {
    const glob = new Bun.Glob(pattern);
    return { test: (name) => glob.match(name) };
  }
  return globToRegExp(pattern);
};
const globs = patterns.map(toMatcher);
const selected = globs.length ? entries.filter((entry) => globs.some((glob) => glob.test(entry.name))) : entries;
for (const [index, pattern] of patterns.entries()) {
  if (!entries.some((entry) => globs[index].test(entry.name))) {
    console.error(`caution: filename not matched:  ${pattern}`);
  }
}

const dosDate = (entry) => {
  const year = (entry.date >> 9) + 1980;
  const month = (entry.date >> 5) & 15;
  const day = entry.date & 31;
  const pad = (value) => String(value).padStart(2, "0");
  return `${year}-${pad(month)}-${pad(day)} ${pad(entry.time >> 11)}:${pad((entry.time >> 5) & 63)}`;
};

// A member's bytes as they inflate, in chunks of at most 1 MiB; its size and CRC are checked as
// they pass, so a member that inflates past its stated size stops there.
const CHUNK = 1 << 20;
async function* data(entry) {
  if (entry.flags & 1) throw new Error("encrypted members are not supported");
  if (entry.method !== 0 && entry.method !== 8) throw new Error(`compression method ${entry.method} is not supported`);
  const local = read(entry.localOffset, 30);
  if (local.readUInt32LE(0) !== 0x04034b50) throw new Error("bad local header");
  const start = entry.localOffset + 30 + local.readUInt16LE(26) + local.readUInt16LE(28);
  if (!validSize(start) || start > directoryOffset || entry.compressedSize > directoryOffset - start)
    throw new Error("invalid member data range");
  function* stored() {
    for (let done = 0; done < entry.compressedSize; done += CHUNK) yield read(start + done, Math.min(CHUNK, entry.compressedSize - done));
  }
  let source = Readable.from(stored(), { objectMode: false });
  if (entry.method === 8) {
    const inflate = createInflateRaw({ chunkSize: 64 * 1024 });
    pipeline(source, inflate).catch(() => {});
    source = inflate;
  }
  let size = 0, crc = 0;
  for await (const chunk of source) {
    size += chunk.length;
    if (size > entry.size) { source.destroy(); throw new Error(`size mismatch (more than ${entry.size})`); }
    crc = crc32(chunk, crc);
    yield chunk;
  }
  if (size !== entry.size) throw new Error(`size mismatch (${size} != ${entry.size})`);
  if (crc !== entry.crc) throw new Error("CRC error");
}

const writeAll = (target, bytes) => {
  for (let offset = 0; offset < bytes.length;) {
    try { offset += writeSync(target, bytes, offset, bytes.length - offset); }
    catch (error) { if (error.code !== "EAGAIN") throw error; }
  }
};

// Unix seconds from the UT field, else the DOS stamp read in local time.
const modified = (entry) => entry.mtime !== undefined ? entry.mtime
  : new Date((entry.date >> 9) + 1980, ((entry.date >> 5) & 15) - 1, entry.date & 31, entry.time >> 11, (entry.time >> 5) & 63, (entry.time & 31) * 2).getTime() / 1000;

// Makes the folders above `relative` under root, one at a time, and refuses any that is not a
// real folder: a symlink there would carry the write outside root.
const parents = (root, relative) => {
  let at = root;
  for (const part of relative.split("/").slice(0, -1)) {
    at = join(at, part);
    let st = null;
    try { st = lstatSync(at); } catch {}
    if (!st) mkdirSync(at);
    else if (!st.isDirectory()) throw new Error(`path runs through ${at}, which is not a folder; skipped`);
  }
};

let status = 0;
if (mode === "list") {
  let total = 0;
  console.log("  Length      Date    Time    Name\n---------  ---------- -----   ----");
  for (const entry of selected) {
    total += entry.size;
    console.log(`${String(entry.size).padStart(9)}  ${dosDate(entry)}   ${entry.name}`);
  }
  console.log(`---------                     -------\n${String(total).padStart(9)}                     ${selected.length} file${selected.length === 1 ? "" : "s"}`);
} else if (mode === "pipe") {
  for (const entry of selected) {
    if (entry.name.endsWith("/")) continue;
    try { for await (const chunk of data(entry)) writeAll(1, chunk); } catch (error) { console.error(`unzip: ${entry.name}: ${error.message}`); status = 2; }
  }
} else if (mode === "test") {
  for (const entry of selected) {
    if (entry.name.endsWith("/")) continue;
    try { for await (const _ of data(entry)); if (!quiet) console.log(`    testing: ${entry.name.padEnd(24)} OK`); }
    catch (error) { console.log(`    testing: ${entry.name.padEnd(24)} ${error.message}`); status = 2; }
  }
  if (status === 0 && quiet < 2) console.log(`No errors detected in compressed data of ${archive}.`);
} else {
  if (!quiet) console.log(`Archive:  ${archive}`);
  const root = resolve(directory);
  mkdirSync(root, { recursive: true });
  // Folder modes and times go on last, deepest first, so a read-only folder still takes its members.
  const folders = [];
  for (const entry of selected) {
    const name = junkPaths ? basename(entry.name) : entry.name;
    if (!name || (junkPaths && entry.name.endsWith("/"))) continue;
    // No absolute paths or "..": a member never lands outside DIR.
    const relative = normalize(name.replace(/^\/+/, ""));
    if (relative.startsWith("..") || relative.split("/").includes("..")) {
      console.error(`unzip: skipping ${entry.name}: path outside the destination`);
      status = 1;
      continue;
    }
    const target = join(root, relative);
    const unixMode = entry.madeBy === 3 ? entry.external >>> 16 : 0;
    const mtime = modified(entry);
    try {
      parents(root, relative);
      if (entry.name.endsWith("/") || (unixMode & 0o170000) === 0o040000) {
        let st = null;
        try { st = lstatSync(target); } catch {}
        if (st && !st.isDirectory()) throw new Error(`${join(directory, relative)} exists and is not a folder`);
        if (!st) mkdirSync(target);
        if (!quiet) console.log(`   creating: ${join(directory, relative)}/`);
        folders.push({ target, mode: unixMode & 0o777, mtime });
        continue;
      }
      const exists = (() => { try { lstatSync(target); return true; } catch { return false; } })();
      if (exists) {
        if (overwrite === false) continue;
        if (overwrite === null) { console.error(`unzip: ${join(directory, relative)} exists; use -o to overwrite or -n to skip`); status = 1; continue; }
        rmSync(target, { force: true });
      }
      if ((unixMode & 0o170000) === 0o120000) {
        if (entry.size > 4096) throw new Error("symlink target is too long");
        const chunks = [];
        for await (const chunk of data(entry)) chunks.push(chunk);
        symlinkSync(Buffer.concat(chunks).toString(), target);
        try { lutimesSync(target, mtime, mtime); } catch {}
      } else {
        // Created here, never opened through a link someone put at the name meanwhile.
        const output = openSync(target, constants.O_WRONLY | constants.O_CREAT | constants.O_EXCL | (constants.O_NOFOLLOW ?? 0), 0o600);
        try {
          for await (const chunk of data(entry)) writeAll(output, chunk);
        } catch (error) {
          closeSync(output);
          rmSync(target, { force: true });
          throw error;
        }
        closeSync(output);
        chmodSync(target, unixMode & 0o777 || 0o666 & ~process.umask());
        utimesSync(target, mtime, mtime);
      }
      if (!quiet) console.log(`  inflating: ${join(directory, relative)}`);
    } catch (error) {
      console.error(`unzip: ${entry.name}: ${error.message}`);
      status = 2;
    }
  }
  for (const { target, mode, mtime } of folders.reverse()) {
    try { if (mode) chmodSync(target, mode); utimesSync(target, mtime, mtime); } catch {}
  }
}
closeSync(fd);
process.exit(status);
