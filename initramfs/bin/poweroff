#!/bin/bun
// poweroff — sync filesystems and power off through Linux reboot(2).

import { LINUX_REBOOT_CMD_POWER_OFF, runPowerCommand } from "../lib/power.js";

await runPowerCommand({
  name: "poweroff",
  command: { name: "LINUX_REBOOT_CMD_POWER_OFF", value: LINUX_REBOOT_CMD_POWER_OFF },
  action: "powering off",
});
