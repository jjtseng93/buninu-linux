{
  "name": "jsmdcui",
  "version": "0.19.1",
  "description": "Markdown as a Common UI for Terminals and Web Browsers",
  "type": "module",
  "main": "./src/index.js",
  "license": "MIT",
  "bin": {
    "jsmdcui": "./src/index.js"
  },
  "scripts": {
    "start": "bun ./src/index.js --demo",
    "tui": "bun ./tui",
    "wui": "bun ./wui",
    "edit": "bun ./edit",
    "check": "bun ./src/index.js --check",
    "clean": "bun ./clean.sh"
  },
  "assets": [
    "demos",
    "runtime",
    "README.md",
    "CHANGELOG.md",
    "cdp-maze.js",
    "src/cui/server.mjs",
    "src/cui/rpc.mjs",
    "testapp.md"
  ]
}
